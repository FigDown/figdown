# RULE 6.2: a retired spelling is a line error that NAMES its migration.
# `size` is the first MERGE rather than a rename (`ELEMENT-GEOMETRY-DIRECTIVE`) — the
# keys did not change spelling, their carrier did — so the message names a
# whole `pin` line instead of a single word. The spelling left the LANGUAGE,
# so the diagnostic fires wherever it appears at line start, ahead of the
# `GENRE-KEYWORD-ALLOWLIST` genre allowlist: the second occurrence is under `bitfield`, a genre
# that never admitted a scene keyword at all.
figdown 0.1 block
node a "A"
size a width=120 height=60

figdown 0.1 bitfield
bitfield h "H" word=32 numbering=msb0
field "flags" 32
size h width=200
