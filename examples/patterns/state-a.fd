# FigDown — figures as text. Spec: https://github.com/FigDown/figdown

figdown 0.2 statechart
title "3-State Cycle with Conditional Transitions"

state idle   "IDLE"    shape=rounded fill=#dbeafe
state active "ACTIVE"  shape=rounded
state wait   "WAIT"    shape=rounded

flow down

transition idle -[cond1]-> active
transition active -[cond2]-> wait
transition wait -[reset]-> idle
transition wait -[retry]-> active
transition active -[abort]-> idle

layout
# Triangular arrangement so cycle edges are spatially distinct from back-edges.
# idle at top-centre; active at bottom-left; wait at bottom-right.
pin idle   at=(180,50)
pin active at=(50,220)
pin wait   at=(310,220)
