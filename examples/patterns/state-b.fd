# FigDown — figures as text. Spec: https://github.com/FigDown/figdown

figdown 0.2 statechart
title "Hub Pattern: Multiple States Converging to Reset"

state idle    "IDLE"     fill=#dbeafe
state state_a "STATE_A"
state state_b "STATE_B"
state state_c "STATE_C"
state state_d "STATE_D"

flow down

transition idle -[cond1]-> state_a
transition idle -[cond2]-> state_b
transition idle -[cond3]-> state_c
transition idle -[cond4]-> state_d
transition state_a -[reset]-> idle
transition state_b -[reset]-> idle
transition state_c -[reset]-> idle
transition state_d -[reset]-> idle
