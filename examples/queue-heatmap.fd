# FigDown — figures as text. Spec: https://github.com/FigDown/figdown

figdown 0.1 table
title "Per-(port, queue) occupancy — one table, two projections"

table hm "Queue occupancy counters"
| Port\Q | Q0 | Q1 | Q2 | Q3 | Q4 | Q5 |
|--------|:--:|:--:|:--:|:--:|:--:|:--:|
| P0     | 12 | 55 | 31 |  8 | 72 | 19 |
| P1     | 44 | 90 | 22 | 61 | 15 | 38 |
| P2     |  5 | 27 | 83 | 47 | 33 | 96 |
| P3     | 68 | 14 | 40 | 29 | 51 |  7 |
# heatmap marks: light red = over 40, strong red = over 80
cell (1,3) fill=#fecaca
cell (1,6) fill=#fca5a5
cell (2,2) fill=#fecaca
cell (2,3) fill=#fca5a5
cell (2,5) fill=#fecaca
cell (3,4) fill=#fca5a5
cell (3,5) fill=#fecaca
cell (3,7) fill=#fca5a5
cell (4,2) fill=#fecaca
cell (4,6) fill=#fecaca

# the same table data, charted on X-Y-Z axes (rows=X, columns=Y, values=Z)
chart hm
