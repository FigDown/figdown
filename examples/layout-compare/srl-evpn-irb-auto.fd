# FigDown — figures as text. Spec: https://github.com/FigDown/figdown

figdown 0.1 topology
title "EVPN-VXLAN IRB — leaves with IP-VRF and bridge domains"

# Complex vendor-style figure, fully hand-laid-out (tier 3, `PIN-COORDINATE-SCOPE` two-level
# coordinates): each group is anchored once; members are group-local, so
# moving a leaf = editing one pin line.

# ── Semantic classes ─────────────────────────────────────────────────
class bridge_domain "Bridge domain — logical L2 forwarding instance with VNI binding, VXLAN-terminated" style=dashed stroke=#1d4ed8
class pe_ce_bgp     "PE-CE BGP IPv4 session — external routing peering between leaf bridge domain and customer edge" style=dashed stroke=#b45309

# ── Overlay cloud + spines ─────────────────────────────────────────
node cloud "EVPN-VXLAN" shape=ellipse fill=#cfe8f7 stroke=#7fb8d8
node sp1 "Spine-1" shape=rounded fill=#9aa2ad
node sp2 "Spine-2" shape=rounded fill=#9aa2ad

# ── Leaves: group = leaf box; members = IP-VRF badge + bridge domains
group leaf2 "SRL LEAF-2"
node vrf2 "IP-VRF-10\nRD1/RT10\nVNI10" in=leaf2 fill=#1e3a8a
node bd2  "BD2\nRD41/RT2\nVNI2"   in=leaf2 class=bridge_domain
node bd24a "BD24\nRD22/RT24\nVNI24" in=leaf2 class=bridge_domain

group leaf4 "SRL LEAF-4"
node vrf4 "IP-VRF-10\nRD1/RT10\nVNI10" in=leaf4 fill=#1e3a8a
node bd24b "BD24\nRD41/RT24\nVNI24" in=leaf4 class=bridge_domain
node bd4  "BD4\nRD42/RT4\nVNI4"  in=leaf4 class=bridge_domain

group leaf3 "SRL LEAF-3"
node vrf3 "IP-VRF-10\nRD1/RT10\nVNI10" in=leaf3 fill=#1e3a8a
node bd3  "BD3\nRD31/RT3\nVNI3"  in=leaf3 class=bridge_domain

# ── Edge devices and hosts ──────────────────────────────────────────
node ce3 "CE-3\nIP-20.1.1.3/24\nMAC-00:01:03:FF:00:0B" shape=rounded
node h2  "HOST-2\nIP-101.1.1.2/24\nMAC-00:00:00:00:00:02" fill=#bae6fd
node srv "SERVER-1\nHOST-12  IP-101.1.1.1/24\nMAC-00:00:64:01:01:01"
node h4  "HOST-4\nIP-104.1.1.1/24\nMAC-00:00:00:00:00:04" fill=#bae6fd
node h3  "HOST-3\nIP-103.1.1.1/24\nMAC-00:00:00:00:00:03" shape=rounded

# fabric attachment
edge sp1 -- cloud
edge sp2 -- cloud
edge cloud ["irb0.24\nAnycast-IP .254"] -- vrf2
edge cloud -- vrf4
edge cloud -- vrf3

# PE-CE and access links, port labels at the endpoints
edge bd2 -["PE-CE\nBGP IPv4"]- [20.1.1.2/24] ce3 class=pe_ce_bgp
edge bd2 [e1/12.24] -- h2
edge bd24a [lag1.24] -- srv
edge bd24b [lag1.24] -- srv

# multi-homing: declare the SEMANTICS (these links form one bundle) and
# the renderer derives the dashed ring — it follows the nodes wherever
# they move; no coordinates involved
bundle es1 "ES-1 / LAG-1" bd24a--srv,bd24b--srv stroke=#0ea5e9
edge bd4 [e1/13.4] -- h4
edge bd3 [e1/2.3] -- h3
