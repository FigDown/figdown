figdown 0.1 block
# 0.1: BOTH spellings of the text channel are now retired, and v0.1
# has no author-facing label colour at all — the default is derived from the
# fill the label sits on (core §5, `LABEL-COLOUR-SOURCE`), and the owner-level key that could
# be added instead would colour an edge's [tail]/[mid]/[head] labels
# identically, which is the wrong shape (core §9 `ANNOTATION-LOCATOR-SPLIT`).
# `color=` is the one key whose diagnostic must name TWO eras and refuse to
# choose: before this release it set the FILL, it set the
# LABEL. No engine can tell the two source files apart, which is exactly why
# the key had to leave — while it was live a pre-0.1 document parsed
# and drew a legal, WRONG figure in silence.
class hot "Hot path" fill=#dc2626 stroke=#dc2626
group g "G" text=#fee2e2
node a "A" text=#fee2e2
edge a -> a text=#dc2626
bundle es1 "ES" a--a text=#0ea5e9
external e text=#fff
# the retirement fires on every directive that ever accepted the key …
node b "B" color=#1f2937
group g2 "G2" color=#1f2937
band "Reserved" 15% in=g color=#dcfce7
# … including the typed-block openers and their items.
bitfield bf "Bits" numbering=msb0 color=#0f172a
field "One" 32 color=#0f172a
# the interior-less three (§8.4): fill= and stroke= named one channel
edge a -> a fill=#dc2626
threshold "cap" in=g offset=50% fill=#a3c93a
bundle es2 "ES2" a--a fill=#0ea5e9 stroke=#0ea5e9
