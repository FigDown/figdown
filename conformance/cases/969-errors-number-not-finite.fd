# core §12.5.1 — A NUMBER MUST BE A FINITE NUMBER.
#
# Each value below matches its position's plain-decimal grammar and is
# 400 digits long, past the largest double (~1.8e308). Until this release
# `pin at=` and table `width` drew `Infinity` coordinates, a classic
# `field` never finished, and `word=` exhausted memory; the rest were
# refused with a message that printed "Infinity". Each is now one line
# error. A large FINITE value stays legal: there is no magnitude limit
# (core §15.5), and 968 pins how one serializes.
figdown 0.5 block
node a "A"
group g "G" 
pin a at=(,0)
pin a 
figdown 0.5 bitfield
bitfield h "H"  numbering=msb0
field "C" 8
field "A" 
field b:
figdown 0.5 table
table t "T"
| A | B |
|---|---|
| a | b |
width ,10%
cell (,1) fill=#ff0000
# A chart reads its numbers from a table: 0.5 refuses one that is not finite
# (it used to draw NaN coordinates with no error).
table t2 "T2"
| A | B |
|---|--:|
| a |  |
chart t2 type=bar3d
